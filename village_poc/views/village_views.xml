<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_village_house_list" model="ir.ui.view">
        <field name="name">village.house.list</field>
        <field name="model">village.house</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="owner_id"/>
                <field name="resident_id"/>
                <field name="monthly_fee"/>
                <field name="fee_outstanding_count"/>
                <field name="fee_outstanding_amount"/>
                <field name="fee_paid_count"/>
                <field name="open_issue_count"/>
                <field name="work_order_count"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_village_fee_charge_list" model="ir.ui.view">
        <field name="name">village.fee.charge.list</field>
        <field name="model">village.fee.charge</field>
        <field name="arch" type="xml">
            <list>
                <field name="house_id"/>
                <field name="period"/>
                <field name="amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state"/>
                <field name="channel"/>
                <field name="paid_receipt"/>
            </list>
        </field>
    </record>

    <record id="view_village_fee_charge_form" model="ir.ui.view">
        <field name="name">village.fee.charge.form</field>
        <field name="model">village.fee.charge</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_paid" type="object" string="Mark paid (simulated)" class="btn-primary" invisible="state != 'outstanding'"/>
                    <field name="state" widget="statusbar" statusbar_visible="outstanding,paid"/>
                </header>
                <sheet>
                    <group>
                        <field name="house_id"/>
                        <field name="period"/>
                        <field name="amount"/>
                        <field name="channel"/>
                        <field name="paid_receipt"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_village_issue_list" model="ir.ui.view">
        <field name="name">village.issue.list</field>
        <field name="model">village.issue</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="house_id"/>
                <field name="title"/>
                <field name="reported_by"/>
                <field name="state"/>
                <field name="maintenance_request_id"/>
            </list>
        </field>
    </record>

    <record id="view_village_issue_form" model="ir.ui.view">
        <field name="name">village.issue.form</field>
        <field name="model">village.issue</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="house_id"/>
                        <field name="title"/>
                        <field name="description"/>
                        <field name="reported_by"/>
                        <field name="state"/>
                        <field name="maintenance_request_id"/>
                    </group>
                    <notebook>
                        <page string="AI advisories (advisory only)">
                            <field name="advisory_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_village_ai_advisory_list" model="ir.ui.view">
        <field name="name">village.ai.advisory.list</field>
        <field name="model">village.ai.advisory</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="issue_id"/>
                <field name="category"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="approved_by"/>
                <field name="maintenance_request_id"/>
            </list>
        </field>
    </record>

    <record id="view_village_ai_advisory_form" model="ir.ui.view">
        <field name="name">village.ai.advisory.form</field>
        <field name="model">village.ai.advisory</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve (staff)" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <group>
                        <field name="issue_id"/>
                        <field name="engine"/>
                        <field name="category"/>
                        <field name="priority"/>
                        <field name="approved_by"/>
                        <field name="approved_at"/>
                        <field name="maintenance_request_id"/>
                    </group>
                    <group>
                        <field name="summary"/>
                        <field name="work_order_text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_village_house" model="ir.actions.act_window">
        <field name="name">Houses / Dashboard (POC)</field>
        <field name="res_model">village.house</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_village_fee_charge" model="ir.actions.act_window">
        <field name="name">Common Fee Charges</field>
        <field name="res_model">village.fee.charge</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_village_issue" model="ir.actions.act_window">
        <field name="name">Resident Requests</field>
        <field name="res_model">village.issue</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_village_ai_advisory" model="ir.actions.act_window">
        <field name="name">AI Advisories</field>
        <field name="res_model">village.ai.advisory</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_village_poc_root" name="Village POC" sequence="90"/>
    <menuitem id="menu_village_house" name="Houses / Dashboard (POC)" parent="menu_village_poc_root" action="action_village_house"/>
    <menuitem id="menu_village_fee" name="Common Fee Charges" parent="menu_village_poc_root" action="action_village_fee_charge"/>
    <menuitem id="menu_village_issue" name="Resident Requests" parent="menu_village_poc_root" action="action_village_issue"/>
    <menuitem id="menu_village_ai_advisory" name="AI Advisories" parent="menu_village_poc_root" action="action_village_ai_advisory"/>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_donation_campaign_tree" model="ir.ui.view">
        <field name="name">donation.campaign.list</field>
        <field name="model">donation.campaign</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="recipient_name"/>
                <field name="category"/>
                <field name="province_id"/>
            </list>
        </field>
    </record>

    <record id="view_donation_entry_list" model="ir.ui.view">
        <field name="name">donation.entry.list</field>
        <field name="model">donation.entry</field>
        <field name="arch" type="xml">
            <list>
                <field name="donor_id"/>
                <field name="campaign_id"/>
                <field name="amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="channel"/>
                <field name="state"/>
                <field name="receipt_ref"/>
                <field name="point_entry_id"/>
            </list>
        </field>
    </record>

    <record id="view_donation_entry_form" model="ir.ui.view">
        <field name="name">donation.entry.form</field>
        <field name="model">donation.entry</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm (simulated payment)" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <group>
                        <field name="donor_id"/>
                        <field name="campaign_id"/>
                        <field name="amount"/>
                        <field name="currency_id"/>
                        <field name="channel"/>
                        <field name="receipt_ref"/>
                        <field name="point_entry_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_impact_point_wallet_list" model="ir.ui.view">
        <field name="name">impact.point.wallet.list</field>
        <field name="model">impact.point.wallet</field>
        <field name="arch" type="xml">
            <list>
                <field name="donor_id"/>
                <field name="balance"/>
            </list>
        </field>
    </record>

    <record id="view_impact_point_wallet_form" model="ir.ui.view">
        <field name="name">impact.point.wallet.form</field>
        <field name="model">impact.point.wallet</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="donor_id"/>
                        <field name="balance"/>
                    </group>
                    <notebook>
                        <page string="Point ledger (append-only)">
                            <field name="entry_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_impact_point_entry_list" model="ir.ui.view">
        <field name="name">impact.point.entry.list</field>
        <field name="model">impact.point.entry</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="wallet_id"/>
                <field name="kind"/>
                <field name="points"/>
                <field name="ref"/>
                <field name="source_donation_id"/>
                <field name="recipient_campaign_id"/>
                <field name="conversion_id"/>
            </list>
        </field>
    </record>

    <record id="view_impact_point_conversion_list" model="ir.ui.view">
        <field name="name">impact.point.conversion.list</field>
        <field name="model">impact.point.conversion</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="wallet_id"/>
                <field name="points"/>
                <field name="partner_label"/>
                <field name="state"/>
                <field name="idempotency_key"/>
                <field name="external_ref"/>
            </list>
        </field>
    </record>

    <record id="action_donation_campaign" model="ir.actions.act_window">
        <field name="name">Campaigns / Recipients</field>
        <field name="res_model">donation.campaign</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_donation_entry" model="ir.actions.act_window">
        <field name="name">Donation Ledger</field>
        <field name="res_model">donation.entry</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_impact_point_wallet" model="ir.actions.act_window">
        <field name="name">Point Wallets</field>
        <field name="res_model">impact.point.wallet</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_impact_point_entry" model="ir.actions.act_window">
        <field name="name">Point Ledger</field>
        <field name="res_model">impact.point.entry</field>
        <field name="view_mode">list</field>
    </record>
    <record id="action_impact_point_conversion" model="ir.actions.act_window">
        <field name="name">Conversions (MOCK)</field>
        <field name="res_model">impact.point.conversion</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_donation_poc_root" name="Donation POC" sequence="90"/>
    <menuitem id="menu_donation_campaign" name="Campaigns / Recipients" parent="menu_donation_poc_root" action="action_donation_campaign"/>
    <menuitem id="menu_donation_entry" name="Donation Ledger" parent="menu_donation_poc_root" action="action_donation_entry"/>
    <menuitem id="menu_impact_point_wallet" name="Point Wallets" parent="menu_donation_poc_root" action="action_impact_point_wallet"/>
    <menuitem id="menu_impact_point_entry" name="Point Ledger" parent="menu_donation_poc_root" action="action_impact_point_entry"/>
    <menuitem id="menu_impact_point_conversion" name="Conversions (MOCK)" parent="menu_donation_poc_root" action="action_impact_point_conversion"/>
</odoo>
